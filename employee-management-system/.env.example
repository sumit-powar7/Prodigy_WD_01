# Server Port and Environment
PORT=3000
NODE_ENV=development

# MongoDB Connection String (If omitted, automatically uses in-memory MongoDB for instant zero-config setup)
MONGODB_URI="mongodb://localhost:27017/employee_db"

# JWT and Cookie Secrets
JWT_SECRET="super_secret_jwt_key_employee_admin_2026"
COOKIE_SECRET="super_secret_cookie_key_2026"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

